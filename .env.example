# Supabase Dashboard → Project Settings → API
# (새 UI: Publishable / Secret  ·  예전 UI: anon / service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Publishable key (또는 Legacy anon public) — 브라우저용
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Secret key (또는 Legacy service_role) — 서버 전용. NEXT_PUBLIC_ 붙이지 말 것. Git 금지.
# 비밀번호 힌트 재설정·업장 공유 API·관리자 조회에 사용.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# 관리자 페이지(/admin) 아이디·비밀번호. Git·클라이언트 노출 금지.
ADMIN_ID=bek9490
ADMIN_PASSWORD=change-me

# 배포된 사이트 주소 (홈 화면 추가 안내·푸시 딥링크). 없으면 접속 중인 주소 사용.
NEXT_PUBLIC_APP_URL=https://direction-nine.vercel.app

# Web Push (VAPID) — npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron 인증 (/api/cron/alerts). Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# 카카오 REST API 키 (선택). 네이버·카카오맵 길찾기 도착 좌표용.
# 없으면 해당 앱은 주소 검색으로 엽니다. Git 금지.
# KAKAO_REST_API_KEY=

# DeepSeek API 키 — 여기에 붙여 넣기 (서버 전용. Git·클라이언트 노출 금지)
# 로컬: 이 파일 또는 .env.local / 배포: Vercel → Settings → Environment Variables
# 없으면 메시지·사진 잔여 분석은 건너뛰고 룰 결과만 반영합니다.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Google AdSense (승인 전에는 아래를 넣지 않거나 ENABLED=false 유지)
# 승인 후: CLIENT + ENABLED=true + 슬롯 ID 설정 → Vercel에도 동일 등록 후 재배포
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ADSENSE_ENABLED=false
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_PUB_ID=pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=
# NEXT_PUBLIC_ADSENSE_SLOT_ABOUT=
